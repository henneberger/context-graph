{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["label"],
  "properties": {
    "label": {"type": "string"},
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "profile": {
      "type": "object",
      "properties": {"active": {"type": "boolean"}},
      "additionalProperties": true
    },
    "tags": {"type": "array", "items": {"type": "string"}},
    "attributes": {}
  },
  "additionalProperties": true
}
