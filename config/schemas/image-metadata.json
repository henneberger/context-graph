{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "uri",
    "width",
    "height",
    "contentType",
    "bytes",
    "sha256"
  ],
  "properties": {
    "uri": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "contentType": {
      "type": "string"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
