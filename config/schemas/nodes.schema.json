{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "node_id",
    "node_type",
    "event_time",
    "source_event_id",
    "properties",
    "workspace_id",
    "resource_id"
  ],
  "properties": {
    "node_id": {
      "type": "string"
    },
    "node_type": {
      "type": "string"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "source_event_id": {
      "type": "string"
    },
    "properties": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
