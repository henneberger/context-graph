{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "streamId",
    "sequence",
    "uri",
    "playlistUri",
    "durationSeconds",
    "keyframeAligned"
  ],
  "properties": {
    "streamId": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "uri": {
      "type": "string"
    },
    "playlistUri": {
      "type": "string"
    },
    "durationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "keyframeAligned": {
      "const": true
    }
  },
  "additionalProperties": true
}
