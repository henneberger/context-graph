{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "edge_id",
    "source_id",
    "target_id",
    "relation",
    "event_time",
    "source_event_id",
    "properties",
    "workspace_id",
    "resource_id",
    "target_resource_id"
  ],
  "properties": {
    "edge_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "relation": {
      "type": "string"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "source_event_id": {
      "type": "string"
    },
    "properties": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_resource_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
